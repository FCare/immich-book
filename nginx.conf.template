server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;

    # Docker's embedded DNS, with a short TTL so a proxy_pass hostname is
    # re-resolved if the upstream container restarts and gets a new IP
    # (a static proxy_pass hostname is otherwise resolved once at nginx
    # startup and cached forever, causing "connection refused" 502s).
    resolver 127.0.0.11 valid=10s;

    # SPA
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy to Immich, same-origin so no CORS needed.
    # The API key is injected here server-side (IMMICH_API_KEY env var,
    # substituted by the nginx entrypoint) and overrides whatever the
    # client sent - the key never needs to reach the browser/JS bundle.
    location /api/ {
        set $immich_upstream immich_server;
        proxy_pass http://$immich_upstream:2283/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header x-api-key "${IMMICH_API_KEY}";
        client_max_body_size 100M;
        # PDF export fetches many "fullsize" images (generated on demand
        # by Immich, not pre-cached like thumbnails); under concurrent
        # load the default 60s can be too short and silently drop some,
        # which shows up as blank photos in the exported PDF.
        proxy_read_timeout 180s;
    }

    # Proxy to the photobook storage backend - saved page styles,
    # captions, ordering etc. per album, so a photobook can be resumed
    # from any device rather than being tied to one browser's storage.
    location /photobooks {
        set $book_backend immich-book-backend;
        proxy_pass http://$book_backend:8000/photobooks;
        proxy_set_header Host $host;
    }

    location /globalconfig {
        set $book_backend immich-book-backend;
        proxy_pass http://$book_backend:8000/globalconfig;
        proxy_set_header Host $host;
    }

    # Merges the PDF chunks the frontend renders client-side into one
    # file - see backend/main.py's /pdf/merge. Uploads can be large (a
    # several-hundred-page book's chunks, at full image quality), and
    # merging that much data takes longer than the other endpoints here.
    location /pdf/ {
        set $book_backend immich-book-backend;
        proxy_pass http://$book_backend:8000/pdf/;
        proxy_set_header Host $host;
        client_max_body_size 0;
        # client_body_timeout guards the upload leg (the browser sending
        # the chunk PDFs to nginx) - proxy_read/send_timeout only cover
        # nginx<->backend, not client<->nginx. Without this, nginx's 60s
        # default kills the connection outright if uploading a large
        # book's chunks takes longer than that, before the backend ever
        # sees the request - which looks exactly like "generation never
        # finishes" with no error surfaced.
        client_body_timeout 300s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        # Stream the upload straight to the backend instead of nginx
        # buffering the whole (potentially huge) request body first.
        proxy_request_buffering off;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|wasm)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    location /health {
        access_log off;
        return 200 "OK\n";
        add_header Content-Type text/plain;
    }
}
