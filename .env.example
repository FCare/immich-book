# --- Development (npm start / vite) ---
# Set this to your Immich server URL for local development
VITE_IMMICH_PROXY_TARGET=https://photos.example.com

# --- Docker deployment (docker compose up) ---
# Same target as above, passed as a build arg instead (see docker-compose.yml)
IMMICH_SERVER_URL=https://photos.example.com

# Immich API key used server-side by nginx (see nginx.conf.template) -
# never sent to the browser. See README.md for the permissions it needs.
IMMICH_API_KEY=

# Name of the external Docker network your reverse proxy and Immich
# server are reachable on - this stack does not create it, only joins
# it. See INTEGRATION.md for the authentication this app expects that
# reverse proxy to provide.
EXTERNAL_NETWORK=immich-book_proxy
